# Valeurs affichées par `npx supabase start` (local) ou dans le dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:57321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comptes de démo sur la page de connexion (mettre false en production)
NEXT_PUBLIC_DEMO_ACCOUNTS=true

# Connexion GitHub : à mettre dans supabase/.env (lu par le CLI Supabase), voir README
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# Le Griot : API Z AI (repli sur les extraits communautaires si l'API est indisponible)
ZAI_API_URL=https://zai-backend-fz6j.onrender.com/api/chat
# Anthropic est utilisé par les clones, le radar et la Centrale IA
ANTHROPIC_API_KEY=
# Recherche sémantique (sans clé : recherche plein texte PostgreSQL)
VOYAGE_API_KEY=

# WhatsApp Business Cloud API (webhook : /api/whatsapp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Micro-Bourse : webhook GitHub (workflow_run + pull_request) sur /api/github/webhook
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Tâche quotidienne (Vercel Cron) : /api/cron
CRON_SECRET=
